{
  "name": "gst-invoice",
  "private": true,
  "version": "0.1.0",
  "description": "BillMitra \u2014 simple low-cost GST invoice SaaS (sales invoices, payments, WhatsApp)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @gst/api db:generate",
    "db:migrate": "pnpm --filter @gst/api db:migrate",
    "db:seed": "pnpm --filter @gst/api db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
