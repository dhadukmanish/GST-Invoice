# Copy to /opt/gst-invoice/.env on the server and fill in. Never commit the real file.
POSTGRES_PASSWORD=        # openssl rand -base64 24 | tr -d '/+='
JWT_SECRET=               # openssl rand -base64 48 | tr -d '/+='   (changing it logs everyone out + needs WhatsApp tokens re-entered)
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD= # your super admin password (used only when no super admin exists yet)
PUBLIC_URL=https://gst.pratishthabridal.in
WEB_PORT=8095             # must be free on the VPS: ss -ltnp | grep 8095
SEED_DEMO=false           # true = also create demo / Demo@1234 client with sample data
